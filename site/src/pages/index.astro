<BaseLayout
  title="Grays Photography — Visual Storytelling for Restaurants & Brands"
  description="Grays Photography crafts cinematic food, lifestyle, and brand photography for restaurants, apparel, and businesses across Chandigarh and India. Directed by Nitin Singh Sandhu. Contact +91 82645 31881."
>
  <Nav />
  <main id="main-content">
