---
// Nav component — sleek glassmorphism with Instagram and WhatsApp
---

<nav id="main-nav" class="nav" aria-label="Main navigation">
  <div class="nav-inner">
    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Grays Photography — Home">
      <img src="/logo.png" alt="Grays Photography" width="80" height="52" class="nav-logo-img" loading="eager" />
    </a>

    <!-- Desktop links -->
    <ul class="nav-links" role="list">
      <li><a href="#work" class="nav-link">Campaigns</a></li>
      <li><a href="#about" class="nav-link">About</a></li>
      <li><a href="#services" class="nav-link">Services</a></li>
      <li><a href="#process" class="nav-link">Process</a></li>
      <li><a href="#contact" class="nav-link">Contact</a></li>
    </ul>

    <!-- Social & CTA -->
    <div class="nav-actions">
      <a
        href="https://www.instagram.com/graysbynitin"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-social-btn"
        aria-label="Instagram @graysbynitin"
        title="Follow on Instagram"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>

      <a
        href="https://wa.me/918264531881?text=Hi%20Nitin,%20I'd%20love%20to%20discuss%20a%20project%20with%20Grays%20Photography."
        target="_blank"
        rel="noopener noreferrer"
        class="nav-cta"
        aria-label="Start a project on WhatsApp"
      >
        <span>Start a Project</span>
      </a>

      <button
        id="menu-btn"
        class="hamburger"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-line menu-line--top"></span>
        <span class="menu-line menu-line--mid"></span>
        <span class="menu-line menu-line--bot"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu -->
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-label="Mobile navigation">
  <div class="mobile-menu-inner">
    <ul class="mobile-links" role="list">
      <li><a href="#work" class="mobile-link">Campaigns</a></li>
      <li><a href="#about" class="mobile-link">About</a></li>
      <li><a href="#services" class="mobile-link">Services</a></li>
      <li><a href="#process" class="mobile-link">Process</a></li>
      <li><a href="#contact" class="mobile-link">Contact</a></li>
      <li>
        <a
          href="https://www.instagram.com/graysbynitin"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-link mobile-link--insta"
        >
          Instagram @graysbynitin
        </a>
      </li>
      <li>
        <a
          href="https://wa.me/918264531881"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-link mobile-link--cta"
        >
          Start a Project →
        </a>
      </li>
    </ul>

    <div class="mobile-footer">
      <p class="mobile-location">Chandigarh, India · Pan-India</p>
      <p class="mobile-discipline">Photography · Direction · Visuals</p>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding-block: 1rem;
    transition: background 0.4s var(--ease-expo),
                backdrop-filter 0.4s var(--ease-expo),
                border-bottom-color 0.4s;
    border-bottom: 1px solid transparent;
  }

  .nav.scrolled {
    background: rgba(250, 247, 242, 0.96);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom-color: var(--border);
    padding-block: 0.7rem;
    box-shadow: 0 2px 24px rgba(30, 20, 5, 0.07);
  }

  .nav-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    transition: opacity 0.2s;
  }
  .nav-logo:hover { opacity: 0.85; }

  .nav-logo-img {
    height: 50px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .nav-links {
    display: none;
    list-style: none;
    align-items: center;
    gap: 2.4rem;
  }

  @media (min-width: 860px) { .nav-links { display: flex; } }

  .nav-link {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    position: relative;
    padding-block: 0.4rem;
    transition: color 0.22s ease;
  }

  .nav-link:hover { color: var(--text-white); }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s var(--ease-expo);
  }

  .nav-link:hover::after { transform: scaleX(1); }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Instagram icon button */
  .nav-social-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: rgba(30, 20, 5, 0.05);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .nav-social-btn:hover {
    border-color: var(--gold);
    color: var(--gold);
    background: rgba(184, 130, 10, 0.12);
    transform: translateY(-2px);
  }

  /* CTA Button */
  .nav-cta {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FAF7F2;
    background: var(--text-primary);
    border: 1px solid var(--text-primary);
    padding: 0.65rem 1.5rem;
    border-radius: 1px;
    transition: all 0.25s var(--ease-expo);
    box-shadow: 0 4px 18px rgba(30, 20, 5, 0.18);
  }

  .nav-cta:hover {
    background: var(--gold);
    border-color: var(--gold);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(184, 130, 10, 0.32);
  }

  @media (max-width: 600px) { .nav-cta { display: none; } }

  /* Hamburger */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    cursor: pointer;
    border: 1px solid var(--border);
    border-radius: 1px;
    background: rgba(30, 20, 5, 0.04);
  }

  @media (min-width: 860px) { .hamburger { display: none; } }

  .menu-line {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--text-secondary);
    border-radius: 1px;
    transition: transform 0.3s, opacity 0.3s;
  }

  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    background: rgba(243, 239, 231, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--gutter);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.38s var(--ease-expo);
  }

  .mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .mobile-link {
    font-family: var(--font-display);
    font-size: clamp(2rem, 7vw, 3.2rem);
    font-weight: 300;
    color: var(--text-white);
    transition: color 0.2s;
    letter-spacing: -0.01em;
  }

  .mobile-link:hover { color: var(--gold); }

  .mobile-link--insta {
    font-family: var(--font-label);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .mobile-link--cta {
    font-family: var(--font-label);
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-white);
    margin-top: 0.5rem;
  }

  .mobile-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }
</style>
