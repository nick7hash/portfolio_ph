---
// Contact + Footer section — "Let's create something extraordinary" preserved & enhanced
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <div class="contact-inner">
    <!-- Left: Inquiry & Direct Communication -->
    <div class="contact-text container">
      <p class="eyebrow reveal"><span class="section-line"></span>Initiate Collaboration</p>

      <h2 id="contact-heading" class="contact-heading reveal delay-1">
        Let's create<br />
        <span class="contact-heading-highlight">something</span><br />
        extraordinary.
      </h2>

      <p class="contact-sub reveal delay-2">
        Whether launching a restaurant menu, designing a seasonal apparel lookbook,
        or creating high-engagement short-form reels for social presence — Nitin &amp; team are ready.
      </p>

      <!-- Interactive Quick Inquiry Form -->
      <div class="inquiry-card reveal delay-3">
        <p class="inquiry-title">Quick Project Inquiry</p>

        <div class="inquiry-services" id="inquiry-services">
          <button type="button" class="service-pill active" data-service="Restaurant & Cafe">Restaurant &amp; Cafe</button>
          <button type="button" class="service-pill" data-service="E-Commerce Products">E-Commerce Products</button>
          <button type="button" class="service-pill" data-service="Lifestyle & Apparel">Lifestyle &amp; Apparel</button>
          <button type="button" class="service-pill" data-service="Bar & Cocktail">Bar &amp; Beverage</button>
          <button type="button" class="service-pill" data-service="Short-Form Video & Reels">Reels &amp; Video</button>
        </div>

        <div class="inquiry-inputs">
          <input
            type="text"
            id="inquiry-name"
            class="inquiry-input"
            placeholder="Your Name or Brand"
            aria-label="Your Name or Brand"
          />
          <input
            type="text"
            id="inquiry-notes"
            class="inquiry-input"
            placeholder="Shoot dates or vision details (optional)"
            aria-label="Shoot dates or vision details"
          />
        </div>

        <div class="inquiry-btns">
          <a
            id="inquiry-submit-btn"
            href="https://wa.me/918264531881?text=Hi%20Nitin,%20I%20would%20like%20to%20discuss%20a%20Restaurant%20%26%20Cafe%20shoot%20with%20Grays%20Photography."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--red inquiry-btn"
            aria-label="Send inquiry via WhatsApp"
          >
            <span>Send via WhatsApp</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>

          <a
            href="https://www.instagram.com/graysbynitin"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--instagram inquiry-insta-btn"
            aria-label="Follow on Instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>DM on Instagram</span>
          </a>
        </div>
      </div>

      <div class="contact-details reveal delay-4">
        <div class="detail-row">
          <span class="detail-label">Lead Photographer</span>
          <span class="detail-value">Nitin Singh Sandhu</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Direct Phone / WhatsApp</span>
          <a href="tel:+918264531881" class="detail-value detail-value--link" id="contact-phone">+91 82645 31881</a>
        </div>
        <div class="detail-row">
          <span class="detail-label">Studio Base</span>
          <span class="detail-value">Chandigarh, India · Available Pan-India</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Instagram</span>
          <a href="https://www.instagram.com/graysbynitin" target="_blank" rel="noopener noreferrer" class="detail-value detail-value--link">@graysbynitin</a>
        </div>
      </div>
    </div>

    <!-- Right: High-fashion lifestyle image -->
    <div class="contact-img-col">
      <img
        src="/images/lifestyle-41.jpg"
        alt="Editorial lifestyle apparel campaign directed by Nitin Singh Sandhu"
        class="contact-img"
        loading="lazy"
        decoding="async"
      />
      <div class="contact-img-gradient" aria-hidden="true"></div>
      <div class="contact-img-tag" aria-hidden="true">
        <span>GRAYS PHOTOGRAPHY</span>
        <span>NITIN SINGH SANDHU · EST. 2016</span>
      </div>
    </div>
  </div>
</section>

<footer class="footer" aria-label="Site footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/logo.png" alt="Grays Photography" width="84" height="56" class="footer-logo-img" loading="lazy" />
        <div class="footer-brand-text">
          <p class="footer-name">GRAYS PHOTOGRAPHY</p>
          <p class="footer-tagline">Visual storytelling crafted by Nitin Singh Sandhu</p>
        </div>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="#work" class="footer-link">Campaigns</a>
        <a href="#about" class="footer-link">About</a>
        <a href="#services" class="footer-link">Services</a>
        <a href="#process" class="footer-link">Process</a>
        <a href="https://www.instagram.com/graysbynitin" target="_blank" rel="noopener noreferrer" class="footer-link footer-link--insta" id="footer-instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span>Instagram</span>
        </a>
        <a href="https://wa.me/918264531881" target="_blank" rel="noopener noreferrer" class="footer-link footer-link--wa" id="footer-whatsapp">
          WhatsApp Direct
        </a>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {new Date().getFullYear()} Grays Photography by Nitin Singh Sandhu. All rights reserved. Chandigarh, India.
      </p>
      <button type="button" class="footer-back-top" id="back-to-top" aria-label="Scroll back to top of page">
        <span>Back to Top</span>
        <span aria-hidden="true">↑</span>
      </button>
    </div>
  </div>
</footer>

<style>
  /* ---- Contact Section ---- */
  .contact {
    background: var(--bg-base);
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--border);
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .contact-inner {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: stretch;
    }
  }

  .contact-text {
    padding-block: var(--space-section);
    max-width: 680px;
    margin-right: auto;
  }

  .contact-heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 300;
    color: var(--text-white);
    line-height: 1.0;
    margin-block: 0.8rem 1.6rem;
    letter-spacing: -0.02em;
  }

  .contact-heading-highlight {
    font-style: italic;
    font-weight: 600;
    color: var(--gold-light);
  }

  .contact-sub {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  /* Quick Inquiry Card */
  .inquiry-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-warm);
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border-radius: 2px;
    margin-bottom: 3rem;
    box-shadow: 0 24px 50px rgba(30, 20, 5, 0.12);
  }

  .inquiry-title {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.2rem;
    font-weight: 400;
    opacity: 0.85;
  }

  .inquiry-services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .service-pill {
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    padding: 0.5rem 1rem;
    border-radius: 1px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.25s ease;
    text-transform: uppercase;
  }

  .service-pill.active {
    background: var(--gold);
    color: #ffffff;
    border-color: var(--gold);
    font-weight: 700;
    box-shadow: 0 4px 16px var(--gold-glow);
  }

  .service-pill:hover:not(.active) {
    border-color: var(--gold);
    color: var(--gold);
  }

  .inquiry-inputs {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .inquiry-input {
    width: 100%;
    background: rgba(250, 247, 242, 0.85);
    border: 1px solid var(--border);
    border-radius: 1px;
    padding: 0.9rem 1.2rem;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    transition: border-color 0.22s, background 0.22s;
  }

  .inquiry-input:focus {
    outline: none;
    border-color: var(--gold);
    background: rgba(255, 253, 248, 0.98);
  }

  .inquiry-input::placeholder { color: var(--text-muted); }

  .inquiry-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .inquiry-btn { flex: 1; min-width: 200px; justify-content: center; }
  .inquiry-insta-btn { justify-content: center; }

  /* Contact Details Table */
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }

  .detail-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media (min-width: 600px) {
    .detail-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }

  .detail-label {
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .detail-value {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--text-white);
    font-weight: 400;
  }

  .detail-value--link {
    color: var(--gold-light);
    transition: color 0.2s;
  }

  .detail-value--link:hover {
    color: var(--text-white);
    text-decoration: underline;
  }

  /* Right Image Column */
  .contact-img-col {
    position: relative;
    min-height: 480px;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .contact-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .contact-img-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 8, 6, 0.12) 0%,
      rgba(10, 8, 6, 0.72) 100%
    );
  }

  .contact-img-tag {
    position: absolute;
    bottom: 2rem; left: 2rem; right: 2rem;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: #FFFFFF;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.85);
    opacity: 0.95;
  }

  /* ---- Footer ---- */
  .footer {
    background: var(--bg-mid);
    border-top: 1px solid var(--border);
    padding-block: 4rem 3rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  @media (min-width: 900px) {
    .footer-top {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-logo-img {
    height: 52px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .footer-name {
    font-family: var(--font-label);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    color: var(--text-white);
    font-weight: 400;
    text-transform: uppercase;
  }

  .footer-tagline {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    align-items: center;
  }

  .footer-link {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .footer-link:hover { color: var(--text-primary); }

  .footer-link--insta {
    color: var(--gold);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .footer-link--wa {
    color: #FAF7F2;
    background: var(--gold);
    border: 1px solid var(--gold);
    padding: 0.45rem 1rem;
    border-radius: 1px;
    box-shadow: 0 4px 16px var(--gold-glow);
    transition: all 0.25s ease;
  }

  .footer-link--wa:hover {
    background: var(--gold-light);
    border-color: var(--gold-light);
    transform: translateY(-1px);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    align-items: flex-start;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-copy {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .footer-back-top {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    transition: color 0.2s;
  }

  .footer-back-top:hover { color: var(--gold); }
</style>

<script>
  let selectedService = "Restaurant & Cafe";
  const servicePills = document.querySelectorAll('.service-pill');
  const nameInput = document.getElementById('inquiry-name') as HTMLInputElement | null;
  const notesInput = document.getElementById('inquiry-notes') as HTMLInputElement | null;
  const submitBtn = document.getElementById('inquiry-submit-btn') as HTMLAnchorElement | null;

  function updateWhatsAppUrl() {
    if (!submitBtn) return;
    const name = nameInput?.value.trim() || 'Client';
    const notes = notesInput?.value.trim() || '';
    let msg = `Hi Nitin, this is ${name}. I am inquiring about a ${selectedService} photoshoot with Grays Photography.`;
    if (notes) {
      msg += ` Details: ${notes}`;
    }
    submitBtn.href = `https://wa.me/918264531881?text=${encodeURIComponent(msg)}`;
  }

  servicePills.forEach((pill) => {
    pill.addEventListener('click', () => {
      servicePills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      selectedService = pill.getAttribute('data-service') || 'Photography';
      updateWhatsAppUrl();
    });
  });

  nameInput?.addEventListener('input', updateWhatsAppUrl);
  notesInput?.addEventListener('input', updateWhatsAppUrl);

  const backToTopBtn = document.getElementById('back-to-top');
  backToTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
