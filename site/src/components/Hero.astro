---
// Hero — Showcases the master art-directed photography poster with action buttons
---

<section class="hero" id="hero" aria-label="Hero section">
  <div class="hero-frame">
    <!-- Master edited poster graphic -->
    <img
      src="/images/hero.png"
      alt="Portfolio of Nitin Singh Sandhu — Grays Photography Chandigarh"
      class="hero-img"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />

    <!-- Floating Action Controls at bottom of poster -->
    <div class="hero-actions-bar container">
      <div class="hero-actions">
        <a href="#work" class="btn btn--red" id="hero-btn-work">
          <span>View Work</span>
          <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>

        <a
          href="https://wa.me/918264531881?text=Hi%20Nitin,%20I'd%20love%20to%20discuss%20a%20project%20with%20Grays%20Photography."
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--ghost"
          id="hero-btn-collaborate"
        >
          <span>Start a Project</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>

        <a
          href="https://www.instagram.com/graysbynitin"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--instagram"
          id="hero-btn-instagram"
          aria-label="Follow Grays Photography on Instagram"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span>@graysbynitin</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: transparent;
    padding-top: var(--nav-height);
    padding-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .hero-frame {
    position: relative;
    width: 100%;
    margin-inline: 0;
    padding-inline: 0;
  }

  .hero-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    border-left: none;
    border-right: none;
    box-shadow: 0 16px 45px rgba(30, 20, 5, 0.08);
  }

  .hero-actions-bar {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    margin-top: 1.5rem;
    display: flex;
    justify-content: flex-end;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
  }

  @media (max-width: 640px) {
    .hero-actions-bar {
      justify-content: center;
    }
    .hero-actions {
      width: 100%;
      justify-content: center;
    }
  }
</style>
