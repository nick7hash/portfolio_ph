---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Grays Photography — Commercial & Editorial Direction by Nitin Singh Sandhu",
  description = "Grays Photography directed by Nitin Singh Sandhu. High-end commercial food & beverage, e-commerce products, and lifestyle lookbooks across India. Instagram @graysbynitin.",
  ogImage = "/images/hero.png",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#FAF7F2" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" type="image/png" href="/logo.png" />
  <title>{title}</title>

  <!-- Preload hero image for LCP -->
  <link rel="preload" as="image" href="/images/hero.png" fetchpriority="high" />
</head>
<body>
  <slot />

  <script>
    // Scroll reveal using IntersectionObserver
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
    );

    document.querySelectorAll('.reveal, .reveal-left, .reveal-scale, .clip-reveal').forEach((el) => {
      observer.observe(el);
    });

    // Nav scroll effect
    const nav = document.getElementById('main-nav');
    const handleScroll = () => {
      if (window.scrollY > 60) {
        nav?.classList.add('scrolled');
      } else {
        nav?.classList.remove('scrolled');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Mobile menu
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuLines = document.querySelectorAll('.menu-line');
    let menuOpen = false;

    menuBtn?.addEventListener('click', () => {
      menuOpen = !menuOpen;
      mobileMenu?.classList.toggle('is-open', menuOpen);
      menuBtn?.setAttribute('aria-expanded', String(menuOpen));
      // Animate hamburger
      if (menuOpen) {
        menuLines[0]?.classList.add('rotate-45');
        menuLines[1]?.classList.add('opacity-0');
        menuLines[2]?.classList.add('-rotate-45');
      } else {
        menuLines[0]?.classList.remove('rotate-45');
        menuLines[1]?.classList.remove('opacity-0');
        menuLines[2]?.classList.remove('-rotate-45');
      }
    });

    // Close on link click
    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menuOpen = false;
        mobileMenu.classList.remove('is-open');
        menuBtn?.setAttribute('aria-expanded', 'false');
        menuLines[0]?.classList.remove('rotate-45');
        menuLines[1]?.classList.remove('opacity-0');
        menuLines[2]?.classList.remove('-rotate-45');
      });
    });
  </script>
</body>
</html>
